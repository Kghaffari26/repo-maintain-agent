# Copy to .env for local runs (never commit the real file).

# Required for triage/changelog LLM calls once agents_core.llm is wired in.
# Nothing in this repo can make an Anthropic API call without it -- see
# DECISIONS.md and STATUS.md for why that's true tonight regardless.
ANTHROPIC_API_KEY=

# Provided automatically in GitHub Actions. Locally, a personal access token
# with at least public_repo read scope is enough for report mode against
# repos you own.
GITHUB_TOKEN=

# A fine-grained PAT for repos NOT covered by GITHUB_TOKEN in Actions (e.g.
# the sandbox repo). Scope: Issues (read/write), Pull requests (read),
# Metadata (read), Checks (read). Only repos configured with token =
# "repo_maint" in config/repos.toml use this.
REPO_MAINT_TOKEN=

# Per-run cost cap in USD, enforced by scripts/run_agent.py.
MAX_RUN_USD=0.25

# Set by the GitHub Actions workflow (as a repo/org *variable*, not a
# secret) to "true" to enable apply mode. Never set this to run apply mode
# locally without understanding SPEC_REPO_MAINT.md §8 first.
APPLY_CHANGES=false
