# Copy to .env for local runs (never commit the real file). `agents-run` loads
# it without overriding variables that are already set.

# Read by agents_core.llm for triage/changelog/fix proposals. If ANTHROPIC_API_KEY is
# reserved by your environment, set AGENTS_ANTHROPIC_API_KEY instead. Without either,
# the run still publishes (status ok, with a warning): issues stay unscored and the
# changelog uses the template grouping.
ANTHROPIC_API_KEY=

# Repos with token = "default" in config/repos.toml. Locally, a token with read
# access to the watched repos is enough for report mode.
GITHUB_TOKEN=

# A fine-grained PAT for repos with token = "repo_maint" (e.g. the sandbox).
# Scope: Issues (read/write), Pull requests (read), Metadata (read), Checks (read);
# plus Contents (read/write) and Pull requests (read/write) on the sandbox ONLY if
# it has allow_fix_prs = true (draft fix-proposal PRs, spec §6.1).
REPO_MAINT_TOKEN=

# Per-run LLM spend cap in USD, enforced by agents_core.costs (CI sets 0.40).
AGENTS_CORE_MAX_RUN_USD=0.40

# Gate 2 of SPEC_REPO_MAINT.md §8.1, meant to come from the repo *variable*
# APPLY_CHANGES in CI (run-agent.yml's apply_changes input). Never set it locally
# without reading §8 first.
APPLY_CHANGES=false
