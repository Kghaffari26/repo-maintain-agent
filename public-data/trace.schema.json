{"$schema":"https://json-schema.org/draft/2020-12/schema","$defs":{"TraceSpan":{"additionalProperties":false,"description":"One timed operation. Nesting is by `parent_id` (None for a root span).","properties":{"id":{"title":"Id","type":"string"},"parent_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Parent Id"},"kind":{"enum":["run","phase","agent_loop","llm_call","tool_call","http","guard","custom"],"title":"Kind","type":"string"},"name":{"title":"Name","type":"string"},"started_at":{"description":"UTC, ISO 8601 with milliseconds","title":"Started At","type":"string"},"duration_ms":{"anyOf":[{"type":"number"},{"type":"null"}],"description":"None if the span never ended","title":"Duration Ms"},"status":{"default":"ok","enum":["ok","error"],"title":"Status","type":"string"},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Error"},"attrs":{"additionalProperties":true,"title":"Attrs","type":"object"}},"required":["id","parent_id","kind","name","started_at","duration_ms","status","error","attrs"],"title":"TraceSpan","type":"object"},"TraceSummary":{"additionalProperties":false,"description":"Roll-up of one run's trace, published in `manifest-entry.json` (see\n`agents_core.tracing`). `steps` counts agent-loop model turns; `guard_retries`\ncounts number-guard retries (a guard that passed first time adds 0).","properties":{"steps":{"default":0,"title":"Steps","type":"integer"},"tool_calls":{"default":0,"title":"Tool Calls","type":"integer"},"llm_calls":{"default":0,"title":"Llm Calls","type":"integer"},"total_latency_ms":{"default":0.0,"title":"Total Latency Ms","type":"number"},"cost_usd":{"default":0.0,"title":"Cost Usd","type":"number"},"guard_retries":{"default":0,"title":"Guard Retries","type":"integer"}},"required":["steps","tool_calls","llm_calls","total_latency_ms","cost_usd","guard_retries"],"title":"TraceSummary","type":"object"}},"additionalProperties":false,"description":"Published as `trace.json`: one run's spans, secrets redacted, size-capped.","properties":{"trace_schema_version":{"default":"1.0.0","title":"Trace Schema Version","type":"string"},"agent":{"title":"Agent","type":"string"},"run_id":{"title":"Run Id","type":"string"},"summary":{"$ref":"#/$defs/TraceSummary"},"spans":{"items":{"$ref":"#/$defs/TraceSpan"},"title":"Spans","type":"array"},"truncated":{"default":false,"title":"Truncated","type":"boolean"},"dropped_spans":{"default":0,"title":"Dropped Spans","type":"integer"}},"required":["trace_schema_version","agent","run_id","summary","spans","truncated","dropped_spans"],"title":"Trace","type":"object"}